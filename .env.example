# Configuración de TikTok Live Agent
# Copia este archivo a .env y rellena los valores

# Usuario de TikTok a escuchar (sin @)
TIKTOK_USERNAME=

# Nombre del moderador (bot): cuando te etiquelen o te nombren, respondes según el contexto.
# Ejemplo: MiBot, @MiBot, etc. (sin @ en el valor; se usa para detectar menciones en el chat)
MODERATOR_NAME=

# Credenciales de sesión TikTok (solo necesarias si USE_BROWSER_SENDER=false, para Euler API)
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=

# Envío: USE_BROWSER_SENDER=true (gratis, navegador) o false (Euler premium)
USE_BROWSER_SENDER=true

# API Key de Euler Stream (solo si USE_BROWSER_SENDER=false)
EULER_API_KEY=

# Modelo de Ollama a usar (opcional; si no se especifica, se detecta automáticamente)
# Para ver modelos disponibles: ollama list
# Ejemplos: llama3, llama3.2, mistral, gemma2:2b, qwen3:1.7b
OLLAMA_MODEL=

# Mostrar en consola los comentarios de otros (true = ver todos, false = solo lo que procesa el bot)
SHOW_OTHER_COMMENTS=false

# Envío automático de mensajes al chat (true/false).
# true  = el bot envía respuestas (solicitudes de canción, saludos, preguntas).
# false = solo escucha y registra (top canciones, etc.) sin escribir en el chat.
ENABLE_AUTO_SEND=true

# Timeout para respuestas de Ollama (clasificación + generación de texto), en milisegundos.
# 0 = sin límite. Ej: 60000 = 1 min, 120000 = 2 min.
OLLAMA_RESPONSE_TIMEOUT_MS=120000

# Respuesta periódica: cada cuántos ms Ollama envía un mensaje al chat (saludo, pide canciones, etc.).
# 120000 = cada 2 min. 0 = desactivado.
OLLAMA_PERIODIC_INTERVAL_MS=120000

# Enviar al chat las respuestas por canciones detectadas (true/false).
ENABLE_SEND_SONG_RESPONSES=false

# Activar RAG (Retrieval-Augmented Generation) para búsqueda de canciones (true/false).
ENABLE_RAG=true

# Umbral de similitud para RAG (0.0 - 1.0). Más alto = coincidencias más estrictas.
RAG_THRESHOLD=0.75

# URL de playlist de YouTube para poblar automáticamente songs.json al iniciar.
# Requiere yt-dlp instalado: pip install yt-dlp
# Solo se actualiza si ENABLE_RAG=true y YOUTUBE_PLAYLIST_URL está definido.
YOUTUBE_PLAYLIST_URL=

# Guardar respuestas en CSV (true/false).
SAVE_RESPONSES_CSV=false

# Ruta del CSV de respuestas.
RESPONSES_CSV_PATH=./responses.csv

# Puerto de debug de Edge para que el bot se conecte via CDP.
# Abre Edge con: "C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe" --remote-debugging-port=9222
BROWSER_DEBUG_PORT=9222
